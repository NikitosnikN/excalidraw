{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "excalidraw-extended-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api-draw.nikitayugov.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PERSISTENCE_KV",
      "id": "9e4e6bc802df4788ac5dd8e8bfb592e7",
      "preview_id": "6ee867ea0c8244e9af34c0d88c55d12a"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://draw.nikitayugov.com"
  },
  "observability": {
    "enabled": true
  }
}
